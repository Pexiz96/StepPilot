@page "/qualifications"
@attribute [Authorize(Roles = $"{AppRoles.Owner},{AppRoles.Admin}")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject TenantGuard TenantGuard

<PageTitle>Qualifikationen | StepPilot</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">Qualifikationen</MudText>

<MudPaper Class="pa-4 mb-5">
    <MudTextField @bind-Value="_edit.Name" Label="Name" Variant="Variant.Outlined" Class="mb-3" />
    <MudTextField @bind-Value="_edit.Description" Label="Beschreibung" Variant="Variant.Outlined" Class="mb-3" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Speichern</MudButton>
</MudPaper>

<MudTable Items="_items">
    <HeaderContent><MudTh>Name</MudTh><MudTh>Beschreibung</MudTh><MudTh>Aktionen</MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd><MudTd>@context.Description</MudTd>
        <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Edit(context))">Bearbeiten</MudButton></MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Qualification> _items = [];
    private Qualification _edit = new();

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        var companyId = await TenantGuard.RequireCompanyIdAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _items = await db.Qualifications.AsNoTracking().Where(x => x.CompanyId == companyId).OrderBy(x => x.Name).ToListAsync();
    }

    private void Edit(Qualification x) => _edit = new Qualification { Id = x.Id, CompanyId = x.CompanyId, Name = x.Name, Description = x.Description, IsActive = x.IsActive };

    private async Task Save()
    {
        var companyId = await TenantGuard.RequireCompanyIdAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _edit.CompanyId = companyId;

        if (_edit.Id == 0) db.Qualifications.Add(_edit);
        else
        {
            var existing = await db.Qualifications.FirstAsync(x => x.Id == _edit.Id && x.CompanyId == companyId);
            db.Entry(existing).CurrentValues.SetValues(_edit);
        }

        await db.SaveChangesAsync();
        _edit = new Qualification();
        await Reload();
    }
}
