@page "/my-time-tracking"
@attribute [Authorize(Roles = AppRoles.Employee)]
@using Microsoft.AspNetCore.Authorization
@using StepPilot.Models
@using StepPilot.Services
@inject TimeTrackingService TimeTrackingService

<PageTitle>Meine Zeiterfassung</PageTitle>
<MudText Typo="Typo.h4" GutterBottom="true">Meine Zeiterfassung</MudText>
<MudText Color="Color.Secondary" Class="mb-4">Arbeitszeit starten, Pausen dokumentieren und Soll-/Ist-Zeiten im Blick behalten.</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_employeeId is null)
{
    <MudAlert Severity="Severity.Warning">Dein Benutzerkonto ist keinem Mitarbeiter zugeordnet.</MudAlert>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
    }
    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">@_success</MudAlert>
    }

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Sollzeit (30 Tage)</MudText><MudText Typo="Typo.h5">@FormatHours(_summary?.PlannedMinutes ?? 0)</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Istzeit</MudText><MudText Typo="Typo.h5">@FormatHours(_summary?.WorkedMinutes ?? 0)</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Zeitkonto</MudText><MudText Typo="Typo.h5" Color="@((_summary?.DifferenceMinutes ?? 0) >= 0 ? Color.Success : Color.Warning)">@FormatSignedHours(_summary?.DifferenceMinutes ?? 0)</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Compliance-Hinweise</MudText><MudText Typo="Typo.h5" Color="@((_summary?.ComplianceWarnings ?? 0) == 0 ? Color.Success : Color.Warning)">@(_summary?.ComplianceWarnings ?? 0)</MudText></MudPaper></MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-5">
                <MudText Typo="Typo.h6">Heute</MudText>
                @if (_active is null)
                {
                    <MudText Class="my-4">Aktuell läuft keine Zeiterfassung.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="ClockIn">Arbeitszeit starten</MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Class="my-4">Gestartet: @_active.StartedAtLocal.ToString("HH:mm") Uhr</MudAlert>
                    <MudNumericField T="int" Label="Pause (Minuten)" @bind-Value="_breakMinutes" Min="0" Class="mb-3" />
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="ClockOut">Arbeitszeit beenden</MudButton>
                }
            </MudPaper>

            @if (_findings.Count > 0)
            {
                <MudPaper Class="pa-4 mt-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Compliance</MudText>
                    @foreach (var finding in _findings.Take(6))
                    {
                        <MudAlert Severity="@(finding.Severity == "Fehler" ? Severity.Error : finding.Severity == "Warnung" ? Severity.Warning : Severity.Info)" Variant="Variant.Outlined" Class="mb-2">
                            @finding.Message <MudText Typo="Typo.caption">@finding.Reference</MudText>
                        </MudAlert>
                    }
                </MudPaper>
            }
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Class="pa-5">
                <MudText Typo="Typo.h6" GutterBottom="true">Letzte Buchungen</MudText>
                <MudTable Items="_entries" Dense="true" Hover="true" RowsPerPage="15">
                    <HeaderContent><MudTh>Datum</MudTh><MudTh>Beginn</MudTh><MudTh>Ende</MudTh><MudTh>Pause</MudTh><MudTh>Soll</MudTh><MudTh>Ist</MudTh><MudTh>Abweichung</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.StartedAtLocal.ToString("dd.MM.yyyy")</MudTd>
                        <MudTd>@context.StartedAtLocal.ToString("HH:mm")</MudTd>
                        <MudTd>@(context.EndedAtLocal?.ToString("HH:mm") ?? "–")</MudTd>
                        <MudTd>@context.BreakMinutes min</MudTd>
                        <MudTd>@(context.Shift is null ? "–" : FormatHours(context.PlannedMinutes))</MudTd>
                        <MudTd>@FormatHours(context.WorkedMinutes)</MudTd>
                        <MudTd>@(context.Shift is null ? "–" : FormatSignedHours(context.VarianceMinutes))</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@StatusText(context.Status)</MudChip>
                            @if (context.Status == TimeEntryStatus.Rejected && !string.IsNullOrWhiteSpace(context.RejectionReason))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@context.RejectionReason</MudText>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.Status == TimeEntryStatus.Rejected)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Resubmit(context.Id))">Erneut einreichen</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager PageSizeOptions="new int[] { 15, 30, 60 }" /></PagerContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loading = true;
    private int? _employeeId;
    private TimeEntry? _active;
    private List<TimeEntry> _entries = [];
    private List<TimeComplianceFinding> _findings = [];
    private TimeTrackingSummary? _summary;
    private int _breakMinutes;
    private string? _error;
    private string? _success;

    protected override async Task OnInitializedAsync()
    {
        _employeeId = await TimeTrackingService.GetCurrentEmployeeIdAsync();
        if (_employeeId is not null) await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        if (_employeeId is null) return;
        var from = DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
        var to = DateOnly.FromDateTime(DateTime.Today);
        _active = await TimeTrackingService.GetActiveAsync(_employeeId.Value);
        _entries = await TimeTrackingService.GetForEmployeeAsync(_employeeId.Value, from, to);
        _summary = await TimeTrackingService.GetSummaryAsync(_employeeId.Value, from, to);
        _findings = await TimeTrackingService.EvaluateActualComplianceAsync(_employeeId.Value, from, to);
        _breakMinutes = _active?.BreakMinutes ?? 0;
    }

    private async Task ClockIn()
    {
        if (_employeeId is null) return;
        try { _error = null; _success = null; await TimeTrackingService.ClockInAsync(_employeeId.Value); _success = "Arbeitszeit wurde gestartet."; await Reload(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ClockOut()
    {
        if (_active is null) return;
        try { _error = null; _success = null; await TimeTrackingService.ClockOutAsync(_active.Id, _breakMinutes); _success = "Arbeitszeit wurde beendet und zur Freigabe eingereicht."; await Reload(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Resubmit(int id)
    {
        try { _error = null; _success = null; await TimeTrackingService.ResubmitAsync(id); _success = "Zeitbuchung wurde erneut eingereicht."; await Reload(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string FormatHours(int minutes) => $"{Math.Abs(minutes) / 60}:{Math.Abs(minutes) % 60:00} h";
    private static string FormatSignedHours(int minutes) => $"{(minutes >= 0 ? "+" : "-")}{Math.Abs(minutes) / 60}:{Math.Abs(minutes) % 60:00} h";
    private static Color StatusColor(TimeEntryStatus status) => status switch { TimeEntryStatus.Approved => Color.Success, TimeEntryStatus.Running => Color.Info, TimeEntryStatus.Rejected => Color.Error, _ => Color.Warning };
    private static string StatusText(TimeEntryStatus status) => status switch { TimeEntryStatus.Running => "Läuft", TimeEntryStatus.Submitted => "Eingereicht", TimeEntryStatus.Approved => "Freigegeben", TimeEntryStatus.Rejected => "Abgelehnt", _ => status.ToString() };
}
