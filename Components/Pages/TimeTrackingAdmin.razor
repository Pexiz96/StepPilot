@page "/time-tracking"
@attribute [Authorize(Roles = $"{AppRoles.Owner},{AppRoles.Admin},{AppRoles.Planner}")]
@using Microsoft.AspNetCore.Authorization
@using StepPilot.Models
@using StepPilot.Services
@inject TimeTrackingService TimeTrackingService
@inject CurrentUserService CurrentUserService

<PageTitle>Zeiterfassung</PageTitle>
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div><MudText Typo="Typo.h4">Zeiterfassung</MudText><MudText Color="Color.Secondary">Ist-Zeiten prüfen, Soll-/Ist-Abweichungen erkennen und Zeiten freigeben.</MudText></div>
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load">Aktualisieren</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Erfasste Zeit</MudText><MudText Typo="Typo.h5">@FormatHours(_workedMinutes)</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Sollzeit</MudText><MudText Typo="Typo.h5">@FormatHours(_plannedMinutes)</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Differenz</MudText><MudText Typo="Typo.h5" Color="@((_workedMinutes - _plannedMinutes) >= 0 ? Color.Success : Color.Warning)">@FormatSignedHours(_workedMinutes - _plannedMinutes)</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Offene Freigaben</MudText><MudText Typo="Typo.h5" Color="@(_pendingCount == 0 ? Color.Success : Color.Warning)">@_pendingCount</MudText></MudPaper></MudItem>
    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
    }
    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">@_success</MudAlert>
    }

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">Ablehnung mit Begründung</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Eine Ablehnung ist nur für eingereichte Zeitbuchungen möglich. Die Begründung wird revisions- und auditfähig gespeichert.</MudText>
        <MudTextField @bind-Value="_rejectionReason" Label="Begründung für Ablehnung" Variant="Variant.Outlined" Lines="2" />
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudTable Items="_entries" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25">
            <HeaderContent><MudTh>Mitarbeiter</MudTh><MudTh>Datum</MudTh><MudTh>Beginn</MudTh><MudTh>Ende</MudTh><MudTh>Pause</MudTh><MudTh>Soll</MudTh><MudTh>Ist</MudTh><MudTh>Differenz</MudTh><MudTh>Status</MudTh><MudTh>Aktionen</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@context.Employee?.FirstName @context.Employee?.LastName</MudTd>
                <MudTd>@context.StartedAtLocal.ToString("dd.MM.yyyy")</MudTd>
                <MudTd>@context.StartedAtLocal.ToString("HH:mm")</MudTd>
                <MudTd>@(context.EndedAtLocal?.ToString("HH:mm") ?? "läuft")</MudTd>
                <MudTd>@context.BreakMinutes min</MudTd>
                <MudTd>@(context.Shift is null ? "–" : FormatHours(context.PlannedMinutes))</MudTd>
                <MudTd>@FormatHours(context.WorkedMinutes)</MudTd>
                <MudTd>@(context.Shift is null ? "–" : FormatSignedHours(context.VarianceMinutes))</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@StatusText(context.Status)</MudChip>
                    @if (context.Status == TimeEntryStatus.Rejected && !string.IsNullOrWhiteSpace(context.RejectionReason))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@context.RejectionReason</MudText>
                    }
                </MudTd>
                <MudTd>
                    @if (context.ClockOutUtc is not null && context.Status == TimeEntryStatus.Submitted)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => Approve(context))">Freigeben</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => Reject(context))">Ablehnen</MudButton>
                    }
                    @if (context.IsManualCorrection)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => LoadRevisions(context))">Revisionen</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" /></PagerContent>
        </MudTable>
    </MudPaper>

    @if (_revisionEntry is not null)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6">Korrekturhistorie · @_revisionEntry.Employee?.FirstName @_revisionEntry.Employee?.LastName</MudText>
            @if (_revisions.Count == 0)
            {
                <MudText Color="Color.Secondary" Class="mt-2">Keine historischen Korrekturen vorhanden.</MudText>
            }
            else
            {
                <MudTable Items="_revisions" Dense="true" Class="mt-3">
                    <HeaderContent><MudTh>Zeitpunkt</MudTh><MudTh>Vorher</MudTh><MudTh>Nachher</MudTh><MudTh>Pause</MudTh><MudTh>Grund</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ChangedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                        <MudTd>@context.PreviousClockInUtc.ToLocalTime().ToString("dd.MM. HH:mm") – @(context.PreviousClockOutUtc?.ToLocalTime().ToString("HH:mm") ?? "offen")</MudTd>
                        <MudTd>@context.NewClockInUtc.ToLocalTime().ToString("dd.MM. HH:mm") – @(context.NewClockOutUtc?.ToLocalTime().ToString("HH:mm") ?? "offen")</MudTd>
                        <MudTd>@context.PreviousBreakMinutes → @context.NewBreakMinutes min</MudTd>
                        <MudTd>@context.Reason</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    }
}

@code {
    private bool _loading = true;
    private List<TimeEntry> _entries = [];
    private List<TimeEntryRevision> _revisions = [];
    private TimeEntry? _revisionEntry;
    private int _workedMinutes;
    private int _plannedMinutes;
    private int _pendingCount;
    private string? _error;
    private string? _success;
    private string? _rejectionReason;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var companyId = await CurrentUserService.GetCompanyIdAsync();
            if (companyId is not null)
            {
                _entries = await TimeTrackingService.GetCompanyEntriesAsync(companyId.Value, DateOnly.FromDateTime(DateTime.Today.AddDays(-31)), DateOnly.FromDateTime(DateTime.Today));
                var completed = _entries.Where(x => x.ClockOutUtc is not null).ToList();
                _workedMinutes = completed.Sum(x => x.WorkedMinutes);
                _plannedMinutes = completed.Sum(x => x.PlannedMinutes);
                _pendingCount = _entries.Count(x => x.Status == TimeEntryStatus.Submitted);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task Approve(TimeEntry entry)
    {
        try
        {
            _error = null; _success = null;
            var user = await CurrentUserService.GetUserAsync();
            await TimeTrackingService.ApproveAsync(entry.Id, user?.Id);
            _success = "Zeitbuchung wurde freigegeben.";
            await Load();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Reject(TimeEntry entry)
    {
        try
        {
            _error = null; _success = null;
            var user = await CurrentUserService.GetUserAsync();
            await TimeTrackingService.RejectAsync(entry.Id, _rejectionReason ?? string.Empty, user?.Id);
            _success = "Zeitbuchung wurde abgelehnt und an den Mitarbeiter zurückgegeben.";
            _rejectionReason = null;
            await Load();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task LoadRevisions(TimeEntry entry)
    {
        _revisionEntry = entry;
        _revisions = await TimeTrackingService.GetRevisionsAsync(entry.Id);
    }

    private static string FormatHours(int minutes) => $"{Math.Abs(minutes) / 60}:{Math.Abs(minutes) % 60:00} h";
    private static string FormatSignedHours(int minutes) => $"{(minutes >= 0 ? "+" : "-")}{Math.Abs(minutes) / 60}:{Math.Abs(minutes) % 60:00} h";
    private static string StatusText(TimeEntryStatus status) => status switch { TimeEntryStatus.Running => "Läuft", TimeEntryStatus.Submitted => "Eingereicht", TimeEntryStatus.Approved => "Freigegeben", TimeEntryStatus.Rejected => "Abgelehnt", _ => status.ToString() };
    private static Color StatusColor(TimeEntryStatus status) => status switch { TimeEntryStatus.Approved => Color.Success, TimeEntryStatus.Running => Color.Info, TimeEntryStatus.Submitted => Color.Warning, TimeEntryStatus.Rejected => Color.Error, _ => Color.Default };
}
