@page "/"

@attribute [Authorize]

@inject DashboardService DashboardService
@inject CurrentUserService CurrentUser

<PageTitle>Dashboard | StepPilot</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">
    Dashboard
</MudText>

<MudText Color="Color.Secondary" Class="mb-6">
    Willkommen bei StepPilot.
</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_isSuperAdmin)
{
    <MudAlert Severity="Severity.Info"
              Variant="Variant.Outlined">

        Du bist als SuperAdmin angemeldet.

        Über den Bereich „Unternehmen“ kannst du Unternehmen
        und deren Owner verwalten.

    </MudAlert>
}
else if (!_hasCompany)
{
    <MudAlert Severity="Severity.Warning"
              Variant="Variant.Outlined">

        Deinem Benutzerkonto ist noch kein Unternehmen zugeordnet.

    </MudAlert>
}
else if (_stats is not null)
{
    <MudGrid>

        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Class="pa-5">
                <MudText>Mitarbeiter</MudText>
                <MudText Typo="Typo.h4">
                    @_stats.Employees
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Class="pa-5">
                <MudText>Schichten heute</MudText>
                <MudText Typo="Typo.h4">
                    @_stats.TodayShifts
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Class="pa-5">
                <MudText>Abwesend</MudText>
                <MudText Typo="Typo.h4">
                    @_stats.Absent
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Class="pa-5">
                <MudText>Offene Schichten</MudText>
                <MudText Typo="Typo.h4">
                    @_stats.OpenShifts
                </MudText>
            </MudPaper>
        </MudItem>

    </MudGrid>
}

@code
{
    private DashboardStats? _stats;

    private bool _isSuperAdmin;
    private bool _hasCompany;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUser.GetUserAsync();

        if (user is null)
        {
            _loading = false;
            return;
        }

        _isSuperAdmin =
            await CurrentUser.IsSuperAdminAsync();

        _hasCompany =
            user.CompanyId is not null;

        if (!_isSuperAdmin && _hasCompany)
        {
            _stats =
                await DashboardService.GetAsync();
        }

        _loading = false;
    }
}