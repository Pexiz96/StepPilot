@page "/absences"
@attribute [Authorize(Roles = $"{AppRoles.Owner},{AppRoles.Admin},{AppRoles.Planner},{AppRoles.Employee}")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject TenantGuard TenantGuard
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NotificationService NotificationService

<PageTitle>Abwesenheiten | StepPilot</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4"><div><MudText Typo="Typo.h4">Abwesenheiten</MudText><MudText Color="Color.Secondary">Urlaub, Krankheit und weitere Abwesenheiten zentral verwalten.</MudText></div><MudSpacer />@if(_isManager){<MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">@_items.Count(x=>x.Status==AbsenceStatus.Requested) offene Anträge</MudChip>}</MudStack>
@if(_loading){<MudPaper Class="pa-8"><MudStack AlignItems="AlignItems.Center" Spacing="3"><MudProgressCircular Indeterminate="true" Color="Color.Primary"/><MudText Color="Color.Secondary">Abwesenheiten werden geladen...</MudText></MudStack></MudPaper>}
else{
@if(!string.IsNullOrWhiteSpace(_errorMessage)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_errorMessage</MudAlert>}
@if(!string.IsNullOrWhiteSpace(_successMessage)){<MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">@_successMessage</MudAlert>}
@if(!_isManager&&_ownEmployee is null){<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Deinem Benutzerkonto ist noch kein Mitarbeiterprofil zugeordnet.</MudAlert>}
else{
<MudPaper Class="pa-5 mb-5" Elevation="1"><MudText Typo="Typo.h6" Class="mb-1">@(_isManager?"Abwesenheit erfassen":"Urlaub beantragen")</MudText><MudText Color="Color.Secondary" Class="mb-4">@(_isManager?"Abwesenheiten erfassen oder Urlaubsanträge bearbeiten.":"Sende deinen Urlaubsantrag direkt an die Planung.")</MudText>
@if(_isManager){<MudSelect T="int" @bind-Value="_edit.EmployeeId" Label="Mitarbeiter" Variant="Variant.Outlined">@foreach(var e in _employees){<MudSelectItem T="int" Value="@e.Id">@e.FirstName @e.LastName</MudSelectItem>}</MudSelect><MudSelect T="AbsenceType" @bind-Value="_edit.Type" Label="Art der Abwesenheit" Variant="Variant.Outlined" Class="mt-3"><MudSelectItem Value="AbsenceType.Vacation">Urlaub</MudSelectItem><MudSelectItem Value="AbsenceType.Sick">Krankheit</MudSelectItem><MudSelectItem Value="AbsenceType.Training">Weiterbildung</MudSelectItem><MudSelectItem Value="AbsenceType.SpecialLeave">Sonderurlaub</MudSelectItem><MudSelectItem Value="AbsenceType.Other">Sonstige</MudSelectItem></MudSelect>}
else{<MudTextField T="string" Value="@GetOwnEmployeeName()" Label="Mitarbeiter" Variant="Variant.Outlined" ReadOnly="true"/><MudTextField T="string" Value="Urlaub" Label="Art" Variant="Variant.Outlined" ReadOnly="true" Class="mt-3"/>}
<MudGrid Class="mt-2"><MudItem xs="12" md="6"><MudDatePicker Label="Von" @bind-Date="_from" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy"/></MudItem><MudItem xs="12" md="6"><MudDatePicker Label="Bis" @bind-Date="_to" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy"/></MudItem></MudGrid><MudTextField @bind-Value="_edit.Reason" Label="Bemerkung" Variant="Variant.Outlined" Lines="3" Class="mt-3"/><MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">@(_isManager?"Abwesenheit speichern":"Urlaub beantragen")</MudButton></MudPaper>
<MudText Typo="Typo.h5" Class="mb-3">@(_isManager?"Abwesenheiten":"Meine Abwesenheiten")</MudText>
<MudTable Items="_items" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Elevation="1"><HeaderContent><MudTh>Mitarbeiter</MudTh><MudTh>Art</MudTh><MudTh>Von</MudTh><MudTh>Bis</MudTh><MudTh>Status</MudTh><MudTh>Bemerkung</MudTh>@if(_isManager){<MudTh>Aktionen</MudTh>}</HeaderContent><RowTemplate><MudTd>@context.Employee?.FirstName @context.Employee?.LastName</MudTd><MudTd>@GetAbsenceTypeText(context.Type)</MudTd><MudTd>@context.StartDate.ToString("dd.MM.yyyy")</MudTd><MudTd>@context.EndDate.ToString("dd.MM.yyyy")</MudTd><MudTd><MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">@GetStatusText(context.Status)</MudChip></MudTd><MudTd>@(string.IsNullOrWhiteSpace(context.Reason)?"–":context.Reason)</MudTd>@if(_isManager){<MudTd>@if(context.Status==AbsenceStatus.Requested){<MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" OnClick="@(()=>Approve(context.Id))">Genehmigen</MudButton><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Class="ml-2" OnClick="@(()=>Reject(context.Id))">Ablehnen</MudButton>}else{<MudText Color="Color.Secondary">Bearbeitet</MudText>}</MudTd>}</RowTemplate><NoRecordsContent><MudText Class="pa-4" Color="Color.Secondary">Noch keine Abwesenheiten vorhanden.</MudText></NoRecordsContent></MudTable>}}

@code{
private List<Employee> _employees=[];private List<Absence> _items=[];private Employee? _ownEmployee;private Absence _edit=new();private DateTime? _from=DateTime.Today;private DateTime? _to=DateTime.Today;private bool _isManager;private bool _isEmployee;private bool _loading=true;private bool _hasCompany;private string _errorMessage="";private string _successMessage="";
protected override async Task OnInitializedAsync(){try{await LoadCurrentUser();if(_hasCompany)await Reload();}catch(Exception ex){_errorMessage=$"Abwesenheiten konnten nicht geladen werden: {ex.Message}";}finally{_loading=false;}}
private async Task LoadCurrentUser(){var a=await AuthenticationStateProvider.GetAuthenticationStateAsync();var p=a.User;if(p.Identity?.IsAuthenticated!=true){_errorMessage="Du bist nicht angemeldet.";return;}var u=await UserManager.GetUserAsync(p);if(u?.CompanyId is null){_errorMessage="Deinem Benutzerkonto ist kein Unternehmen zugeordnet.";return;}_hasCompany=true;_isEmployee=p.IsInRole(AppRoles.Employee);_isManager=p.IsInRole(AppRoles.Owner)||p.IsInRole(AppRoles.Admin)||p.IsInRole(AppRoles.Planner);if(!_isManager&&_isEmployee){await using var db=await DbFactory.CreateDbContextAsync();_ownEmployee=await db.Employees.AsNoTracking().FirstOrDefaultAsync(x=>x.CompanyId==u.CompanyId&&x.ApplicationUserId==u.Id);if(_ownEmployee is not null){_edit.EmployeeId=_ownEmployee.Id;_edit.Type=AbsenceType.Vacation;}}}
private async Task Reload(){var c=await TenantGuard.RequireCompanyIdAsync();await using var db=await DbFactory.CreateDbContextAsync();if(_isManager){_employees=await db.Employees.AsNoTracking().Where(x=>x.CompanyId==c&&x.IsActive).OrderBy(x=>x.LastName).ThenBy(x=>x.FirstName).ToListAsync();_items=await db.Absences.AsNoTracking().Include(x=>x.Employee).Where(x=>x.CompanyId==c).OrderBy(x=>x.Status).ThenByDescending(x=>x.StartDate).ToListAsync();}else if(_ownEmployee is not null){_items=await db.Absences.AsNoTracking().Include(x=>x.Employee).Where(x=>x.CompanyId==c&&x.EmployeeId==_ownEmployee.Id).OrderByDescending(x=>x.StartDate).ToListAsync();}}
private async Task Save(){ClearMessages();if(_from is null||_to is null){_errorMessage="Bitte Start- und Enddatum auswählen.";return;}if(_from.Value.Date>_to.Value.Date){_errorMessage="Das Enddatum darf nicht vor dem Startdatum liegen.";return;}if(_isEmployee&&!_isManager){if(_ownEmployee is null){_errorMessage="Es wurde kein Mitarbeiterprofil gefunden.";return;}_edit.EmployeeId=_ownEmployee.Id;_edit.Type=AbsenceType.Vacation;}if(_edit.EmployeeId==0){_errorMessage="Bitte einen Mitarbeiter auswählen.";return;}var c=await TenantGuard.RequireCompanyIdAsync();await using var db=await DbFactory.CreateDbContextAsync();var employee=await db.Employees.AsNoTracking().FirstOrDefaultAsync(x=>x.Id==_edit.EmployeeId&&x.CompanyId==c);if(employee is null){_errorMessage="Der Mitarbeiter wurde nicht gefunden.";return;}var start=DateOnly.FromDateTime(_from.Value);var end=DateOnly.FromDateTime(_to.Value);if(await db.Absences.AnyAsync(x=>x.CompanyId==c&&x.EmployeeId==_edit.EmployeeId&&x.Status!=AbsenceStatus.Rejected&&x.StartDate<=end&&x.EndDate>=start)){_errorMessage="Für diesen Zeitraum existiert bereits eine Abwesenheit.";return;}var absence=new Absence{CompanyId=c,EmployeeId=_edit.EmployeeId,Type=_edit.Type,StartDate=start,EndDate=end,Reason=_edit.Reason?.Trim(),CreatedAt=DateTime.UtcNow,Status=_edit.Type==AbsenceType.Vacation?AbsenceStatus.Requested:AbsenceStatus.Approved};db.Absences.Add(absence);await db.SaveChangesAsync();if(absence.Status==AbsenceStatus.Requested){await NotificationService.CreateForRolesAsync(c,new[]{AppRoles.Owner,AppRoles.Admin,AppRoles.Planner},"Neuer Urlaubsantrag",$"{employee.FirstName} {employee.LastName} beantragt Urlaub vom {start:dd.MM.yyyy} bis {end:dd.MM.yyyy}.");_successMessage="Der Urlaubsantrag wurde gespeichert und die Planung benachrichtigt.";}else{_successMessage="Die Abwesenheit wurde gespeichert.";}ResetForm();await Reload();}
private async Task Approve(int id)=>await Decide(id,true);private async Task Reject(int id)=>await Decide(id,false);
private async Task Decide(int id,bool approved){if(!_isManager)return;ClearMessages();var c=await TenantGuard.RequireCompanyIdAsync();await using var db=await DbFactory.CreateDbContextAsync();var absence=await db.Absences.Include(x=>x.Employee).FirstOrDefaultAsync(x=>x.Id==id&&x.CompanyId==c);if(absence is null){_errorMessage="Der Antrag wurde nicht gefunden.";return;}if(absence.Status!=AbsenceStatus.Requested){_errorMessage="Der Antrag wurde bereits bearbeitet.";return;}absence.Status=approved?AbsenceStatus.Approved:AbsenceStatus.Rejected;await db.SaveChangesAsync();if(!string.IsNullOrWhiteSpace(absence.Employee?.ApplicationUserId)){await NotificationService.CreateAsync(c,absence.Employee.ApplicationUserId,approved?"Urlaub genehmigt":"Urlaub abgelehnt",$"Dein Urlaubsantrag vom {absence.StartDate:dd.MM.yyyy} bis {absence.EndDate:dd.MM.yyyy} wurde {(approved?"genehmigt":"abgelehnt")}.");}_successMessage=approved?"Der Urlaubsantrag wurde genehmigt.":"Der Urlaubsantrag wurde abgelehnt.";await Reload();}
private void ResetForm(){_edit=new Absence();if(_isEmployee&&!_isManager&&_ownEmployee is not null){_edit.EmployeeId=_ownEmployee.Id;_edit.Type=AbsenceType.Vacation;}_from=DateTime.Today;_to=DateTime.Today;}
private void ClearMessages(){_errorMessage="";_successMessage="";}private string GetOwnEmployeeName()=>_ownEmployee is null?"":$"{_ownEmployee.FirstName} {_ownEmployee.LastName}";private static string GetAbsenceTypeText(AbsenceType t)=>t switch{AbsenceType.Vacation=>"Urlaub",AbsenceType.Sick=>"Krankheit",AbsenceType.Training=>"Weiterbildung",AbsenceType.SpecialLeave=>"Sonderurlaub",AbsenceType.Other=>"Sonstige",_=>t.ToString()};private static string GetStatusText(AbsenceStatus s)=>s switch{AbsenceStatus.Requested=>"Beantragt",AbsenceStatus.Approved=>"Genehmigt",AbsenceStatus.Rejected=>"Abgelehnt",_=>s.ToString()};private static Color GetStatusColor(AbsenceStatus s)=>s switch{AbsenceStatus.Requested=>Color.Warning,AbsenceStatus.Approved=>Color.Success,AbsenceStatus.Rejected=>Color.Error,_=>Color.Default};}
