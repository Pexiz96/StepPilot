@page "/locations"
@attribute [Authorize(Roles = $"{AppRoles.Owner},{AppRoles.Admin}")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject TenantGuard TenantGuard

<PageTitle>Standorte | StepPilot</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">Standorte</MudText>

<MudPaper Class="pa-4 mb-5">
    <MudGrid>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_edit.Name" Label="Name" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_edit.City" Label="Ort" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6"><MudTextField @bind-Value="_edit.AddressLine" Label="Straße" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="3"><MudTextField @bind-Value="_edit.PostalCode" Label="PLZ" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="3"><MudTextField @bind-Value="_edit.FederalStateCode" Label="Bundesland-Code" HelperText="z. B. DE-BE, DE-BY" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="string" @bind-Value="_edit.TimeZoneId" Label="Zeitzone" Variant="Variant.Outlined">
                @foreach (var zone in _timeZones)
                {
                    <MudSelectItem Value="@zone.Id">@zone.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">Die Zeitzone wird für Zeiterfassung, Nachtarbeit und Sommer-/Winterzeit verwendet. Für deutsche Standorte ist Europe/Berlin empfohlen.</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Speichern</MudButton>
</MudPaper>

<MudTable Items="_items">
    <HeaderContent><MudTh>Name</MudTh><MudTh>Ort</MudTh><MudTh>Bundesland</MudTh><MudTh>Zeitzone</MudTh><MudTh>Status</MudTh><MudTh>Aktionen</MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd><MudTd>@context.City</MudTd><MudTd>@(context.FederalStateCode ?? "–")</MudTd><MudTd>@context.TimeZoneId</MudTd><MudTd>@(context.IsActive ? "Aktiv" : "Inaktiv")</MudTd>
        <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Edit(context))">Bearbeiten</MudButton></MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Location> _items = [];
    private Location _edit = new();
    private readonly (string Id, string Label)[] _timeZones =
    [
        ("Europe/Berlin", "Europe/Berlin – Deutschland"),
        ("Europe/Vienna", "Europe/Vienna – Österreich"),
        ("Europe/Zurich", "Europe/Zurich – Schweiz"),
        ("Europe/London", "Europe/London – Vereinigtes Königreich"),
        ("UTC", "UTC")
    ];

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        var companyId = await TenantGuard.RequireCompanyIdAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _items = await db.Locations.AsNoTracking().Where(x => x.CompanyId == companyId).OrderBy(x => x.Name).ToListAsync();
    }

    private void Edit(Location x) => _edit = new Location
    {
        Id = x.Id,
        CompanyId = x.CompanyId,
        Name = x.Name,
        AddressLine = x.AddressLine,
        PostalCode = x.PostalCode,
        City = x.City,
        FederalStateCode = x.FederalStateCode,
        TimeZoneId = string.IsNullOrWhiteSpace(x.TimeZoneId) ? "Europe/Berlin" : x.TimeZoneId,
        IsActive = x.IsActive
    };

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_edit.Name)) return;
        var companyId = await TenantGuard.RequireCompanyIdAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _edit.CompanyId = companyId;
        _edit.TimeZoneId = string.IsNullOrWhiteSpace(_edit.TimeZoneId) ? "Europe/Berlin" : _edit.TimeZoneId.Trim();
        _edit.FederalStateCode = string.IsNullOrWhiteSpace(_edit.FederalStateCode) ? null : _edit.FederalStateCode.Trim().ToUpperInvariant();

        if (_edit.Id == 0) db.Locations.Add(_edit);
        else
        {
            var existing = await db.Locations.FirstAsync(x => x.Id == _edit.Id && x.CompanyId == companyId);
            db.Entry(existing).CurrentValues.SetValues(_edit);
        }

        await db.SaveChangesAsync();
        _edit = new Location();
        await Reload();
    }
}
