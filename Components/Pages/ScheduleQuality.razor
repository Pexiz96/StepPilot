@page "/schedule-quality"
@attribute [Authorize(Roles = $"{AppRoles.Owner},{AppRoles.Admin},{AppRoles.Planner}")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject TenantGuard TenantGuard
@inject WorkTimeComplianceService ComplianceService

<PageTitle>Planqualität | StepPilot</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-5">
    <div>
        <MudText Typo="Typo.h4">Planqualität</MudText>
        <MudText Color="Color.Secondary">Besetzung, Konflikte und Arbeitszeit-Compliance für die nächsten 14 Tage auf einen Blick.</MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Neu prüfen</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid Class="mb-5">
        <MudItem xs="12" sm="6" lg="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Unterbesetzt</MudText><MudText Typo="Typo.h4">@_understaffed.Count</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" lg="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Planungskonflikte</MudText><MudText Typo="Typo.h4">@PlanningConflictCount</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" lg="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Compliance kritisch</MudText><MudText Typo="Typo.h4" Color="@(ComplianceErrorCount > 0 ? Color.Error : Color.Success)">@ComplianceErrorCount</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" lg="3"><MudPaper Class="pa-4"><MudText Color="Color.Secondary">Qualitätsstatus</MudText><MudText Typo="Typo.h5" Color="@StatusColor">@StatusText</MudText></MudPaper></MudItem>
    </MudGrid>

    @if (IssueCount == 0 && _complianceFindings.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Für die nächsten 14 Tage wurden keine Planungs- oder Compliance-Probleme erkannt.</MudAlert>
    }
    else
    {
        @if (ComplianceErrorCount > 0)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                @ComplianceErrorCount arbeitszeitrechtlich kritische Prüfung(en) wurden erkannt. Diese sollten vor Veröffentlichung des Plans geklärt werden.
            </MudAlert>
        }
        else if (IssueCount > 0 || ComplianceWarningCount > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">Der Plan enthält Punkte, die vor Veröffentlichung geprüft werden sollten.</MudAlert>
        }

        @if (_complianceFindings.Count > 0)
        {
            <MudPaper Class="pa-4 mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <div>
                        <MudText Typo="Typo.h6">Arbeitszeit & Compliance</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Priorisiert nach Schweregrad. Die Hinweise unterstützen die Planung und ersetzen keine rechtliche Einzelfallprüfung.</MudText>
                    </div>
                    <MudSpacer />
                    <MudButton Href="/compliance-settings" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Rule">Regelprofil</MudButton>
                </MudStack>

                @foreach (var item in _complianceFindings.OrderBy(x => SeverityRank(x.Severity)).ThenBy(x => x.Date).ThenBy(x => x.EmployeeName))
                {
                    <MudAlert Severity="@ToMudSeverity(item.Severity)" Variant="Variant.Outlined" Class="mb-2">
                        <MudText Typo="Typo.subtitle2">@item.EmployeeName · @item.Date.ToString("dd.MM.yyyy") · @item.Start.ToString("HH:mm")–@item.End.ToString("HH:mm")</MudText>
                        <MudText Typo="Typo.body2">@item.Message</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.LegalReference · Code: @item.Code</MudText>
                    </MudAlert>
                }
            </MudPaper>
        }

        @if (_understaffed.Count > 0)
        {
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-3">Unterbesetzte Schichten</MudText>
                <MudTable Items="_understaffed" Dense="true" Hover="true">
                    <HeaderContent><MudTh>Datum</MudTh><MudTh>Zeit</MudTh><MudTh>Bedarf</MudTh><MudTh>Besetzt</MudTh></HeaderContent>
                    <RowTemplate><MudTd>@context.Date.ToString("dd.MM.yyyy")</MudTd><MudTd>@context.Start.ToString("HH:mm")–@context.End.ToString("HH:mm")</MudTd><MudTd>@context.Required</MudTd><MudTd>@context.Assigned</MudTd></RowTemplate>
                </MudTable>
                <MudButton Href="/schedule" Variant="Variant.Text" Class="mt-2">Schichtplanung öffnen</MudButton>
            </MudPaper>
        }

        @if (_absenceConflicts.Count > 0)
        {
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-3">Einsatz trotz genehmigter Abwesenheit</MudText>
                @foreach (var item in _absenceConflicts)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-2">@item</MudAlert>
                }
            </MudPaper>
        }

        @if (_overlaps.Count > 0)
        {
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Zeitlich überschneidende Schichten</MudText>
                @foreach (var item in _overlaps)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-2">@item</MudAlert>
                }
            </MudPaper>
        }
    }
}

@code {
    private bool _loading = true;
    private List<UnderstaffedRow> _understaffed = [];
    private List<string> _absenceConflicts = [];
    private List<string> _overlaps = [];
    private List<ComplianceRow> _complianceFindings = [];

    private int PlanningConflictCount => _absenceConflicts.Count + _overlaps.Count;
    private int ComplianceErrorCount => _complianceFindings.Count(x => x.Severity == ComplianceSeverity.Error);
    private int ComplianceWarningCount => _complianceFindings.Count(x => x.Severity == ComplianceSeverity.Warning);
    private int IssueCount => _understaffed.Count + PlanningConflictCount + ComplianceErrorCount;
    private string StatusText => ComplianceErrorCount > 0 || PlanningConflictCount > 0 ? "Kritisch" : IssueCount > 0 || ComplianceWarningCount > 0 ? "Prüfen" : "Sehr gut";
    private Color StatusColor => StatusText == "Kritisch" ? Color.Error : StatusText == "Prüfen" ? Color.Warning : Color.Success;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var companyId = await TenantGuard.RequireCompanyIdAsync();
            var today = DateOnly.FromDateTime(DateTime.Today);
            var until = today.AddDays(13);
            await using var db = await DbFactory.CreateDbContextAsync();

            var shifts = await db.Shifts.AsNoTracking()
                .Include(x => x.Assignments).ThenInclude(x => x.Employee)
                .Where(x => x.CompanyId == companyId && x.Date >= today && x.Date <= until)
                .OrderBy(x => x.Date).ThenBy(x => x.StartTime)
                .ToListAsync();

            _understaffed = shifts
                .Where(x => x.Assignments.Count < x.RequiredEmployees)
                .Select(x => new UnderstaffedRow(x.Date, x.StartTime, x.EndTime, x.RequiredEmployees, x.Assignments.Count))
                .ToList();

            var employeeIds = shifts.SelectMany(x => x.Assignments).Select(x => x.EmployeeId).Distinct().ToList();
            var absences = await db.Absences.AsNoTracking()
                .Where(x => x.CompanyId == companyId && employeeIds.Contains(x.EmployeeId) && x.Status == AbsenceStatus.Approved && x.StartDate <= until && x.EndDate >= today)
                .ToListAsync();

            _absenceConflicts = [];
            foreach (var shift in shifts)
            {
                foreach (var assignment in shift.Assignments)
                {
                    if (absences.Any(a => a.EmployeeId == assignment.EmployeeId && a.StartDate <= shift.Date && a.EndDate >= shift.Date))
                    {
                        var name = EmployeeName(assignment.Employee, assignment.EmployeeId);
                        _absenceConflicts.Add($"{name} ist am {shift.Date:dd.MM.yyyy} eingeplant, obwohl eine genehmigte Abwesenheit vorliegt.");
                    }
                }
            }

            _overlaps = [];
            var assignments = shifts.SelectMany(s => s.Assignments.Select(a => new { Shift = s, Assignment = a })).ToList();
            foreach (var group in assignments.GroupBy(x => x.Assignment.EmployeeId))
            {
                var ordered = group.OrderBy(x => x.Shift.Date).ThenBy(x => x.Shift.StartTime).ToList();
                for (var i = 0; i < ordered.Count; i++)
                {
                    for (var j = i + 1; j < ordered.Count; j++)
                    {
                        var a = ordered[i].Shift;
                        var b = ordered[j].Shift;
                        if (a.Date != b.Date) break;
                        if (Overlaps(a.StartTime, a.EndTime, b.StartTime, b.EndTime))
                        {
                            var name = EmployeeName(ordered[i].Assignment.Employee, group.Key);
                            _overlaps.Add($"{name} hat am {a.Date:dd.MM.yyyy} überschneidende Schichten ({a.StartTime:HH:mm}–{a.EndTime:HH:mm} und {b.StartTime:HH:mm}–{b.EndTime:HH:mm}).");
                        }
                    }
                }
            }

            _complianceFindings = [];
            foreach (var shift in shifts)
            {
                foreach (var assignment in shift.Assignments)
                {
                    var findings = await ComplianceService.EvaluateAssignmentAsync(companyId, assignment.EmployeeId, shift);
                    var name = EmployeeName(assignment.Employee, assignment.EmployeeId);
                    foreach (var finding in findings)
                    {
                        _complianceFindings.Add(new ComplianceRow(
                            shift.Date,
                            shift.StartTime,
                            shift.EndTime,
                            name,
                            finding.Code,
                            finding.Severity,
                            finding.Message,
                            finding.LegalReference));
                    }
                }
            }

            _complianceFindings = _complianceFindings
                .GroupBy(x => new { x.Date, x.EmployeeName, x.Code })
                .Select(x => x.First())
                .ToList();
        }
        finally { _loading = false; }
    }

    private static string EmployeeName(Employee? employee, int id) =>
        employee is null ? $"Mitarbeiter #{id}" : $"{employee.FirstName} {employee.LastName}";

    private static Severity ToMudSeverity(ComplianceSeverity severity) => severity switch
    {
        ComplianceSeverity.Error => Severity.Error,
        ComplianceSeverity.Warning => Severity.Warning,
        _ => Severity.Info
    };

    private static int SeverityRank(ComplianceSeverity severity) => severity switch
    {
        ComplianceSeverity.Error => 0,
        ComplianceSeverity.Warning => 1,
        _ => 2
    };

    private static bool Overlaps(TimeOnly aStart, TimeOnly aEnd, TimeOnly bStart, TimeOnly bEnd)
    {
        var a1 = aStart.ToTimeSpan(); var a2 = aEnd.ToTimeSpan(); if (a2 <= a1) a2 += TimeSpan.FromDays(1);
        var b1 = bStart.ToTimeSpan(); var b2 = bEnd.ToTimeSpan(); if (b2 <= b1) b2 += TimeSpan.FromDays(1);
        return a1 < b2 && b1 < a2;
    }

    private sealed record UnderstaffedRow(DateOnly Date, TimeOnly Start, TimeOnly End, int Required, int Assigned);
    private sealed record ComplianceRow(DateOnly Date, TimeOnly Start, TimeOnly End, string EmployeeName, string Code, ComplianceSeverity Severity, string Message, string LegalReference);
}
