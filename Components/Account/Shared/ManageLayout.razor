@inherits LayoutComponentBase
@layout StepPilot.Components.Layout.MainLayout

<div class="account-shell">

    <aside class="account-sidebar">

        <div class="account-sidebar-header">

            <MudAvatar Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Large">

                <MudIcon Icon="@Icons.Material.Filled.Person" />

            </MudAvatar>

            <div>

                <MudText Typo="Typo.h6">
                    Mein Konto
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">
                    StepPilot
                </MudText>

            </div>

        </div>

        <MudDivider Class="account-divider" />

        <div class="account-sidebar-nav">
            <ManageNavMenu />
        </div>

        <div class="account-sidebar-footer">

            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser"
                     Color="Color.Primary"
                     Size="Size.Small" />

            <div>

                <MudText Typo="Typo.body2">
                    StepPilot
                </MudText>

                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">
                    Sicher. Modern. Planen.
                </MudText>

            </div>

        </div>

    </aside>


    <main class="account-content">

        <div class="account-header">

            <MudAvatar Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Large"
                       Class="account-main-avatar">

                <MudIcon Icon="@Icons.Material.Filled.Person"
                         Size="Size.Large" />

            </MudAvatar>

            <div>

                <MudText Typo="Typo.h3">
                    Manage your account
                </MudText>

                <MudText Typo="Typo.h6"
                         Color="Color.Secondary">
                    Change your account settings and manage your profile information.
                </MudText>

            </div>

        </div>


        <MudPaper Class="account-card"
                  Elevation="2">

            @Body

        </MudPaper>


        <MudPaper Class="account-help-card"
                  Elevation="0">

            <MudIcon Icon="@Icons.Material.Filled.Info"
                     Color="Color.Primary"
                     Size="Size.Large" />

            <div>

                <MudText Typo="Typo.h6">
                    Need help?
                </MudText>

                <MudText Typo="Typo.body1"
                         Color="Color.Secondary">

                    If you have any questions or need assistance with your account,
                    please contact your administrator.

                </MudText>

            </div>

        </MudPaper>

    </main>

</div>


<style>

    .account-shell {
        display: grid;
        grid-template-columns: 280px 1fr;
        min-height: calc(100vh - 64px);
        gap: 24px;
    }


    .account-sidebar {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - 64px);
        padding: 24px;
        border-right: 1px solid rgba(255,255,255,0.08);
        justify-content: flex-start;
    }


    .account-sidebar-header {
        display: flex;
        align-items: center;
        gap: 14px;
        flex: 0 0 auto;
    }


    .account-divider {
        margin-top: 20px !important;
        margin-bottom: 18px !important;
        flex: 0 0 auto;
    }


    /* WICHTIG:
           Dadurch entsteht keine große Lücke mehr. */

    .account-sidebar-nav {
        display: block;
        width: 100%;
        height: auto !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        flex: 0 0 auto !important;
    }


        .account-sidebar-nav .mud-navmenu {
            display: block !important;
            width: 100%;
            height: auto !important;
            min-height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            flex: 0 0 auto !important;
        }


        .account-sidebar-nav .account-nav {
            height: auto !important;
            min-height: 0 !important;
            margin: 0 !important;
            flex: 0 0 auto !important;
        }


    .account-sidebar-footer {
        margin-top: 18px;
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 16px;
        border: 1px solid rgba(120,100,255,0.25);
        border-radius: 14px;
        flex: 0 0 auto;
    }


    .account-content {
        max-width: 1050px;
        width: 100%;
        padding: 40px 24px 60px 0;
    }


    .account-header {
        display: flex;
        align-items: center;
        gap: 24px;
        margin-bottom: 32px;
    }


    .account-main-avatar {
        width: 88px !important;
        height: 88px !important;
    }


    .account-card {
        padding: 32px;
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,0.08);
    }


    .account-help-card {
        margin-top: 24px;
        padding: 24px;
        display: flex;
        align-items: flex-start;
        gap: 18px;
        border-radius: 18px;
        border: 1px solid rgba(90,120,255,0.35);
    }


    @@media (max-width: 900px) {

        .account-shell {
            grid-template-columns: 1fr;
        }


        .account-sidebar {
            min-height: auto;
            border-right: none;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }


        .account-content {
            padding: 24px;
        }


        .account-header {
            align-items: flex-start;
        
    }

</style>